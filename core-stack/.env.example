# CORE Configuration
CORE_PORT=3033
CORE_DOMAIN=core.example.com

# Remix Auth / Encryption Secrets
SESSION_SECRET=your_secure_session_secret
ENCRYPTION_KEY=your_secure_encryption_key
MAGIC_LINK_SECRET=your_secure_magic_link_secret
LOGIN_ORIGIN=https://core.example.com
APP_ORIGIN=https://core.example.com

# LLM Providers (Configure keys for the models your agents will use)
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key

# PostgreSQL Configuration
POSTGRES_DB=core_brain
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password

# Neo4j Configuration
NEO4J_PASSWORD=your_secure_graph_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# Queue configuration (use bullmq for local self-hosted stack)
QUEUE_PROVIDER=bullmq
