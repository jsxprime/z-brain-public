# At least one embedding provider is required. OpenRouter is tried first, Gemini SDK as fallback.
OPENROUTER_API_KEY=your-openrouter-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

DATABASE_URL=postgresql://postgres:corepostgres1234@core-postgres:5432/core_brain
REDIS_URL=redis://:coreRedis1234@core-redis:6379
